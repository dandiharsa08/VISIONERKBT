function filterProjects(status, element) {
    // Update active button
    const container = element.closest('div');
    container.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
    element.classList.add('active');
    
    // Filter projects
    let filtered = userProjects;
    if (status === 'ongoing') filtered = userProjects.filter(p => p.status === 'ongoing');
    if (status === 'completed') filtered = userProjects.filter(p => p.status === 'completed');
    
    const projectsList = document.getElementById('projects-list');
    if (projectsList) {
        projectsList.innerHTML = filtered.map(project => `
            <div class="ongoing-card" onclick="showProjectDetail(${project.id})">
                <div class="ongoing-icon" style="background:${project.company === 'Tokopedia' ? '#eff6ff' : project.company === 'Gojek' ? '#f5f3ff' : '#ecfdf5'}">
