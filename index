/* PERBAIKAN INTEREST CONTAINER */
.interest-container {
    max-width: 800px;
    margin: -40px auto 60px;
    background: #fff;
    border-radius: 24px;
    padding: 40px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.1);
    position: relative;
    z-index: 2;
}

.interest-container {
    max-width: 800px;
    margin: -40px auto 60px;
    background: #fff;
    border-radius: 24px;
    padding: 40px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.1);
    position: relative;
    z-index: 2;
}

.interest-progress {
    margin-bottom: 40px;
}

.progress-steps {
    display: flex;
    justify-content: space-between;
    margin-bottom: 16px;
    position: relative;
}

.step-indicator {
    width: 44px;
    height: 44px;
    background: #e5e7eb;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    color: #6b7280;
    transition: all 0.3s;
    position: relative;
    z-index: 2;
    font-size: 16px;
}

.step-indicator.active {
    background: linear-gradient(135deg, var(--blue), var(--green));
    color: #fff;
    box-shadow: 0 4px 12px rgba(37,99,235,0.3);
}

.step-indicator.completed {
    background: var(--green);
    color: #fff;
}

.progress-bar-line {
    height: 4px;
    background: #e5e7eb;
    border-radius: 4px;
    margin-top: -30px;
    position: relative;
}

.progress-fill-line {
    height: 100%;
    background: linear-gradient(90deg, var(--blue), var(--green));
    border-radius: 4px;
    width: 0%;
    transition: width 0.3s;
}

.question-container {
    min-height: 400px;
}

.question-card {
    animation: fadeIn 0.5s ease;
}

.question-text {
    font-size: 24px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 32px;
    line-height: 1.4;
}

.options-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
}

.option-btn {
    padding: 16px 24px;
    background: var(--gray-light);
    border: 2px solid var(--border);
    border-radius: 16px;
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
    cursor: pointer;
    transition: all 0.3s;
    text-align: center;
}

.option-btn:hover {
    border-color: var(--blue);
    background: var(--blue-light);
    transform: translateY(-2px);
}

.option-btn.selected {
    background: linear-gradient(135deg, var(--blue), var(--green));
    border-color: transparent;
    color: #fff;
    box-shadow: 0 4px 12px rgba(37,99,235,0.3);
}

.question-nav {
    display: flex;
    justify-content: space-between;
    margin-top: 40px;
    gap: 16px;
}

.btn-prev, .btn-next, .btn-submit {
    padding: 12px 28px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
    border: none;
}

.btn-prev {
    background: var(--gray-light);
    color: var(--text-muted);
}

.btn-prev:hover {
    background: var(--border);
    transform: translateX(-2px);
}

.btn-next {
    background: linear-gradient(135deg, var(--blue), var(--green));
    color: #fff;
    margin-left: auto;
}

.btn-next:hover {
    transform: translateX(2px);
    box-shadow: 0 4px 12px rgba(37,99,235,0.3);
}

.btn-submit {
    background: linear-gradient(135deg, var(--green), var(--blue));
    color: #fff;
    margin-left: auto;
}

.btn-submit:hover {
    transform: translateX(2px);
    box-shadow: 0 4px 12px rgba(5,150,105,0.3);
}

/* Result Section */
.result-section {
