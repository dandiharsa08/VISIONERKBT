}

.result-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 28px;
    max-width: 1200px;
    margin: 40px auto;
}

.result-card {
    background: #fff;
    border-radius: 20px;
    padding: 28px;
    transition: all 0.3s;
    border: 1px solid var(--border);
}

.result-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    border-color: var(--blue);
}

.result-card-icon {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    margin-bottom: 20px;
}

.result-card-title {
    font-size: 20px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 12px;
}

.result-card-desc {
    font-size: 14px;
    color: var(--text-muted);
