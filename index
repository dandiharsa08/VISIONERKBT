// Fungsi edit profile
let tempSkills = [];

function addSkillOnEnter(event) {
    if (event.key === 'Enter') {
        event.preventDefault();
        const input = event.target;
        const skill = input.value.trim();
        if (skill && !tempSkills.includes(skill)) {
            tempSkills.push(skill);
            updateSkillTags();
            input.value = '';
        }
    }
}

function removeSkill(skill) {
    tempSkills = tempSkills.filter(s => s !== skill);
    updateSkillTags();
}

function updateSkillTags() {
    const container = document.getElementById('skillContainer');
    if (container) {
        const inputField = container.querySelector('.skill-input-field');
        container.innerHTML = `
            ${tempSkills.map(skill => `
                <span class="skill-tag-item">
                    ${skill}
                    <button onclick="removeSkill('${skill}')">✕</button>
                </span>
            `).join('')}
            <input type="text" class="skill-input-field" id="skillInput" placeholder="Tambah skill..." onkeypress="addSkillOnEnter(event)">
        `;
    }
}

