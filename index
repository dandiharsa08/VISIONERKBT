// Fungsi switch tab dashboard
function switchDashboardTab(tabName) {
    // Update active state di sidebar
    document.querySelectorAll('.sidebar-item').forEach(item => {
        item.classList.remove('active');
    });
    document.querySelector(`.sidebar-item[data-tab="${tabName}"]`).classList.add('active');
    
    // Render konten sesuai tab
    const content = document.getElementById('dash-content');
    
    switch(tabName) {
        case 'overview':
            renderOverviewTab(content);
            break;
        case 'projects':
            renderProjectsTab(content);
            break;
        case 'portfolio':
            renderPortfolioTab(content);
            break;
        case 'certificates':
            renderCertificatesTab(content);
            break;
        case 'profile':
            renderProfileTab(content);
            break;
        case 'achievements':
            renderAchievementsTab(content);
            break;
    }
}

