function updateProgress(projectId) {
    const newProgress = prompt('Masukkan progress terbaru (0-100%):', '50');
    if (newProgress && !isNaN(newProgress) && newProgress >= 0 && newProgress <= 100) {
        const project = userProjects.find(p => p.id === projectId);
        if (project) {
            project.progress = parseInt(newProgress);
            if (project.progress === 100) {
                project.status = 'completed';
                project.rating = 4.8;
                project.feedback = "Selamat! Project kamu telah selesai. Tim mentor akan memberikan feedback segera.";
                alert('🎉 Selamat! Project telah selesai. Portfolio dan sertifikat akan segera tersedia.');
            } else {
                alert(`✅ Progress berhasil diupdate ke ${newProgress}%`);
            }
            closeProjectModal();
            switchDashboardTab('projects');
        }
    }
}

