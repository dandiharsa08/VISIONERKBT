    color: #c4b5fd;
    padding: 6px 16px;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 20px;
}

.interest-hero h1 {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 800;
    color: #fff;
