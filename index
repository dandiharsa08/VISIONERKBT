    margin-bottom: 16px;
}

.skills-tag {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
}

.skill-tag {
    padding: 6px 12px;
    background: var(--blue-light);
    color: var(--blue);
    border-radius: 8px;
    font-size: 12px;
    font-weight: 500;
}

.result-action {
    display: flex;
    gap: 16px;
    justify-content: center;
    margin-top: 40px;
}

.result-action .btn-outline {
    background: transparent;
    color: var(--blue);
