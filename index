// Fungsi handle login yang sudah diperbaiki
function handleLogin() {
    const email = document.getElementById('loginEmail').value.trim();
    const password = document.getElementById('loginPassword').value;
    
    // Validasi sederhana
    if (!email || !password) {
        alert('⚠️ Email dan password harus diisi!');
        return;
    }
    
    // Ambil data users dari localStorage
    const usersData = localStorage.getItem('visioner_users');
    let users = [];
    
    if (usersData) {
        users = JSON.parse(usersData);
    }
    
    // Cari user berdasarkan email dan password
    const user = users.find(u => u.email === email && u.password === password);
    
    if (user) {
        // Simpan session user yang login
        localStorage.setItem('visioner_current_user', JSON.stringify(user));
        alert(`✅ Selamat datang kembali, ${user.nama}!`);
        closeModal();
        showPage('dashboard');
        updateDashboardWithUserData(user);
    } else {
        // Cek apakah email terdaftar
        const emailExists = users.some(u => u.email === email);
        if (emailExists) {
            alert('❌ Password salah! Silakan coba lagi.');
        } else {
            alert('❌ Email belum terdaftar! Silakan daftar terlebih dahulu.');
        }
    }
}

// Fungsi handle registrasi yang sudah diperbaiki
function handleRegister() {
    // Ambil semua nilai dari form
    const nama = document.getElementById('regNama').value.trim();
    const email = document.getElementById('regEmail').value.trim();
    const wa = document.getElementById('regWa').value.trim();
    const password = document.getElementById('regPassword').value;
    const confirmPassword = document.getElementById('regConfirmPassword').value;
    const universitas = document.getElementById('regUniversitas').value.trim();
    const jurusan = document.getElementById('regJurusan').value.trim();
    const semester = document.getElementById('regSemester').value;
    const skill = document.getElementById('regSkill').value.trim();
    const minat = document.getElementById('regMinat').value;
    const terms = document.getElementById('regTerms').checked;
    
    // Validasi lengkap
    let errors = [];
    
    if (!nama) errors.push('• Nama lengkap harus diisi');
    if (!email) errors.push('• Email harus diisi');
    if (!wa) errors.push('• Nomor WhatsApp harus diisi');
    if (!password) errors.push('• Password harus diisi');
    if (password.length < 8) errors.push('• Password minimal 8 karakter');
    if (password !== confirmPassword) errors.push('• Konfirmasi password tidak sama');
    if (!universitas) errors.push('• Asal universitas harus diisi');
    if (!jurusan) errors.push('• Jurusan harus diisi');
    if (!semester) errors.push('• Semester harus dipilih');
    if (!skill) errors.push('• Skill yang dikuasai harus diisi');
    if (!minat) errors.push('• Minat karir harus dipilih');
    if (!terms) errors.push('• Harap menyetujui Syarat & Ketentuan');
    
    // Validasi format email
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (email && !emailRegex.test(email)) errors.push('• Format email tidak valid');
    
    // Validasi format WhatsApp (minimal 10 digit, maksimal 13 digit)
    const cleanWa = wa.replace(/\D/g, '');
    if (wa && (cleanWa.length < 10 || cleanWa.length > 13)) errors.push('• Nomor WhatsApp tidak valid (10-13 digit)');
    
    // Tampilkan error jika ada
    if (errors.length > 0) {
        alert('❌ Mohon lengkapi data berikut:\n\n' + errors.join('\n'));
        return;
    }
    
    // Ambil data users yang sudah ada
    const usersData = localStorage.getItem('visioner_users');
    let users = [];
    
    if (usersData) {
        users = JSON.parse(usersData);
    }
    
    // Cek apakah email sudah terdaftar
    if (users.some(u => u.email === email)) {
        alert('❌ Email sudah terdaftar! Silakan login atau gunakan email lain.');
        return;
    }
    
    // Buat data user baru
    const newUser = {
        id: Date.now(),
        nama: nama,
        email: email,
        wa: wa,
        password: password,
        universitas: universitas,
        jurusan: jurusan,
        semester: semester,
        skill: skill.split(',').map(s => s.trim()).filter(s => s !== ''),
        minat: minat,
        bergabung: new Date().toISOString(),
        poin: 0,
        level: 1,
        projectSelesai: 0,
        rating: 0
    };
    
    // Simpan ke localStorage
    users.push(newUser);
    localStorage.setItem('visioner_users', JSON.stringify(users));
    localStorage.setItem('visioner_current_user', JSON.stringify(newUser));
    
    alert(`🎉 Selamat! Akun ${nama} berhasil dibuat.\n\n📧 Email: ${email}\n🏫 Universitas: ${universitas}\n🎯 Minat: ${minat}\n\nSilakan lengkapi profilmu di dashboard!`);
    
    // Reset form registrasi
    document.getElementById('regNama').value = '';
    document.getElementById('regEmail').value = '';
    document.getElementById('regWa').value = '';
    document.getElementById('regPassword').value = '';
    document.getElementById('regConfirmPassword').value = '';
    document.getElementById('regUniversitas').value = '';
    document.getElementById('regJurusan').value = '';
    document.getElementById('regSemester').value = '';
    document.getElementById('regSkill').value = '';
    document.getElementById('regMinat').value = '';
    document.getElementById('regTerms').checked = false;
    
    closeModal();
    showPage('dashboard');
    updateDashboardWithUserData(newUser);
}

